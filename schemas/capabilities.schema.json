{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI CoE upstream capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_on",
    "scope",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "layer": {
            "enum": [
              "Governance",
              "Agent intelligence",
              "Engineering",
              "Persistent context",
              "Model and compute",
              "Execution",
              "Research",
              "Commercial intelligence",
              "Human intelligence",
              "Continuous evolution"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 12
          },
          "owner": {
            "type": "string",
            "minLength": 3
          },
          "published_repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://github[.]com/[^/]+/[^/]+/blob/[a-f0-9]{40}/.+$"
          },
          "file_blob": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "license": {
            "enum": [
              "NOASSERTION",
              "MIT",
              "Apache-2.0",
              "LicenseRef-Reserved",
              "FSL-1.1-ALv2"
            ]
          },
          "license_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://github[.]com/[^/]+/[^/]+/blob/[a-f0-9]{40}/LICENSE$"
          },
          "maturity": {
            "enum": [
              "operating-method",
              "skill-source",
              "protocol",
              "implementation-source",
              "implementation-tested",
              "upstream-template",
              "reference"
            ]
          },
          "dependencies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "enum": [
              "source-inspected",
              "local-fixture-passed"
            ]
          },
          "mode": {
            "enum": [
              "reference-only",
              "optional-local-probe"
            ]
          }
        },
        "required": [
          "id",
          "layer",
          "purpose",
          "owner",
          "published_repository",
          "revision",
          "source_url",
          "file_blob",
          "license",
          "license_url",
          "maturity",
          "dependencies",
          "verification",
          "mode"
        ]
      }
    }
  }
}
